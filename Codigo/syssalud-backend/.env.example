PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=syssalud
DB_PASSWORD=syssalud
DB_NAME=syssalud

JWT_SECRET=super_clave_secreta_syssalud_2026
JWT_EXPIRES_IN=8h

# URLs de otros módulos (Requerido para Pacientes)
AUTH_API_URL=http://localhost:3001/api
NOTIFICACIONES_API_URL=http://localhost:3002/api
PACIENTES_VALIDAR_AUTH=true

# Historia Clínica (CUU09) — costuras REST
PACIENTES_API_URL=http://localhost:4000/api
TURNOS_API_URL=http://localhost:4000/api
# lenient: si Pacientes/Turnos no responden se degrada con WARN; strict: 424
HISTORIA_VALIDAR_TURNOS=lenient

# Turnos (CUU02-04) — costuras REST salientes (TUR-042)
SERVICIOS_API_URL=http://localhost:4000/api
PROFESIONALES_API_URL=http://localhost:4000/api
AGENDA_API_URL=http://localhost:4000/api
PAGOS_API_URL=http://localhost:4000/api
# lenient: si Agenda/Pacientes no responden se degrada con WARN; strict: 424
TURNOS_VALIDAR_AGENDA=lenient
TURNOS_VALIDAR_PACIENTES=lenient
# minutos que dura la reserva temporal (SOLICITADO) antes de vencer
TURNOS_RESERVA_MIN=15

# Profesionales (alta y horarios) — Auth vive en el mismo proceso Nest, se
# inyecta AuthService directo (no hay costura HTTP para esto todavía).
# lenient: si Auth rechaza el alta se degrada con usuarioId=null + WARN; strict: 424
PROFESIONALES_VALIDAR_AUTH=lenient

# Servicios (CUU10) — valida profesionalIds contra Profesionales (SER-023)
# lenient: si Profesionales no responde se acepta con WARN; strict: 424
SERVICIOS_VALIDAR_PROFESIONALES=lenient

# Agenda (AGE-028) — usa PROFESIONALES/TURNOS/SERVICIOS/PACIENTES_API_URL de arriba
FERIADOS_API_URL=
AGENDA_MODO=lenient
AGENDA_CACHE_TTL_S=60
